# Submodules are pinned to the commits recorded in the tree: there is deliberately no `branch`
# entry, so `git submodule update` restores exactly these versions and `--remote` has nothing to
# drift toward. DuckDB's parser/planner internals are not a stable API -- see docs/limitations.md.
#   duckdb              v2.0.0          d54cbbe3df17e8e5ce68312f483b4155836112aa
#   extension-ci-tools  v2.0-cyanoptera 78bd1e4abbd543822166d5b07644751ba1fc6e8d
#   fkYAML              v0.4.4          1818a25156b9b1a65a9c9b6126631e2cd7cfa8f6
[submodule "duckdb"]
	path = duckdb
	url = https://github.com/duckdb/duckdb
[submodule "extension-ci-tools"]
	path = extension-ci-tools
	url = https://github.com/duckdb/extension-ci-tools
[submodule "third_party/fkYAML"]
	path = third_party/fkYAML
	url = https://github.com/fktn-k/fkYAML
